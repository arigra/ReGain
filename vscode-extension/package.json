{
  "name": "regain",
  "displayName": "ReGain",
  "description": "Opens a project's .regain pages with runnable Python and shell blocks and project-reviewed line explanations.",
  "version": "1.1.10",
  "publisher": "arigra",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "regain",
          "title": "ReGain",
          "icon": "media/regain.svg"
        }
      ]
    },
    "views": {
      "regain": [
        {
          "id": "regain.start",
          "name": "Get Started"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "regain.start",
        "contents": "Let Codex trace the project, then explore its capability map and analyzed source walkthroughs.\n[Prepare current project](command:regain.initCurrent)\n[Choose a project folder](command:regain.initFolder)\n[Create an empty folder](command:regain.createFolder)"
      }
    ],
    "commands": [
      {
        "command": "regain.initCurrent",
        "title": "ReGain: Prepare Current Project"
      },
      {
        "command": "regain.initFolder",
        "title": "ReGain: Prepare Another Project Folder"
      },
      {
        "command": "regain.createFolder",
        "title": "ReGain: Create Empty Folder"
      }
    ],
    "customEditors": [
      {
        "viewType": "regain.page",
        "displayName": "ReGain page",
        "selector": [
          {
            "filenamePattern": "**/.regain/*.html"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "regain.notebook",
        "displayName": "ReGain notebook",
        "selector": [
          {
            "filenamePattern": "*.regain.md"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "ReGain",
      "properties": {
        "regain.python": {
          "type": "string",
          "default": "",
          "description": "Python used for the kernel. Empty: the interpreter selected in the Python extension, else python3. It needs jupyter_client and ipykernel."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node scripts/stage-tooling.js",
    "test": "node test/format.test.js && node test/diff.test.js && node test/view.test.js && node test/provider.test.js && node test/kernel.test.js",
    "package": "vsce package --skip-license -o ../dist/"
  },
  "devDependencies": {
    "jsdom": "^24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arigra/ReGain"
  }
}
